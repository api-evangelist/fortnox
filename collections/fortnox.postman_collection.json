{
  "info": {
    "name": "Fortnox REST API",
    "description": "Representative subset of the Fortnox REST API (https://api.fortnox.se/3/). Every request requires the Access-Token (Bearer JWT) and Client-Secret headers from your OAuth2-authorized Fortnox app. Set accessToken and clientSecret collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.fortnox.se/3" },
    { "key": "accessToken", "value": "" },
    { "key": "clientSecret", "value": "" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "Access-Token", "type": "string" },
      { "key": "value", "value": "{{accessToken}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Invoices",
      "item": [
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Access-Token", "value": "{{accessToken}}" },
              { "key": "Client-Secret", "value": "{{clientSecret}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Access-Token", "value": "{{accessToken}}" },
              { "key": "Client-Secret", "value": "{{clientSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"Invoice\":{\"CustomerNumber\":\"1\",\"InvoiceRows\":[{\"ArticleNumber\":\"1\",\"DeliveredQuantity\":\"1\",\"Price\":100}]}}" },
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Retrieve invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Access-Token", "value": "{{accessToken}}" },
              { "key": "Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/invoices/:DocumentNumber", "host": ["{{baseUrl}}"], "path": ["invoices", ":DocumentNumber"], "variable": [{ "key": "DocumentNumber", "value": "" }] }
          }
        },
        {
          "name": "Update invoice",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Access-Token", "value": "{{accessToken}}" },
              { "key": "Client-Secret", "value": "{{clientSecret}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"Invoice\":{}}" },
            "url": { "raw": "{{baseUrl}}/invoices/:DocumentNumber", "host": ["{{baseUrl}}"], "path": ["invoices", ":DocumentNumber"], "variable": [{ "key": "DocumentNumber", "value": "" }] }
          }
        }
      ]
    },
