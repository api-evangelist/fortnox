        },
        {
          "info": {
            "name": "Retrieve an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fortnox.se/3/orders/:DocumentNumber",
            "params": [
              {
                "name": "DocumentNumber",
                "value": "",
                "type": "path",
                "description": "The document number identifying the invoice/order/offer."
              }
            ]
          },
          "docs": "Retrieve an order"
        },
        {
          "info": {
            "name": "Update an order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.fortnox.se/3/orders/:DocumentNumber",
            "params": [
              {
                "name": "DocumentNumber",
                "value": "",
                "type": "path",
                "description": "The document number identifying the invoice/order/offer."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an order"
        }
