              }
            ]
          },
          "docs": "Retrieve a supplier"
        },
        {
          "info": {
            "name": "Update a supplier",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.fortnox.se/3/suppliers/:SupplierNumber",
            "params": [
              {
                "name": "SupplierNumber",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a supplier"
        }
